# Pelican on a bicycle. Theme -> materials -> masses -> one frame. Pixel scene, no outline
# (full-bleed ground; outline only rings transparency).
light sun = dir 1:1 #ffe6b0 amb #c5d4e4 18%

material feather = #f7fbff cloth spread 180%
material wingMat = #d5dee8 cloth spread 160%
material beakMat = #f0b429 cloth spread 150%
material pouchMat = #f6d36b cloth spread 160%
material frameMat = #3a4148 metal spread 140%

draw ride 192x128:
  rect #d7ecf8 0:0 191:84 fill
  rect #c5ddb4 0:84 191:127 fill
  ellipse #b7d4a4 96:98 80:8 fill

  rear = ellipse(46:96, 22:22).subtract(ellipse(46:96, 14:14))
  front = ellipse(146:96, 22:22).subtract(ellipse(146:96, 14:14))
  model rear frameMat
  model front frameMat
  fill #2c3338 ellipse(46:96, 4:4)
  fill #2c3338 ellipse(146:96, 4:4)
  line #6a7380 46:74 46:118
  line #6a7380 24:96 68:96
  line #6a7380 146:74 146:118
  line #6a7380 124:96 168:96

  line #2c3338 46:96 86:96 w3
  line #2c3338 46:96 74:64 w3
  line #2c3338 74:64 112:72 w3
  line #2c3338 112:72 146:96 w3
  line #2c3338 74:64 86:96 w3
  line #2c3338 112:72 124:50 w3
  line #2c3338 114:48 148:46 w3
  line #2c3338 64:62 90:60 w3
  line #2c3338 86:96 76:114 w2
  line #2c3338 86:96 98:114 w2
  fill #2c3338 ellipse(76:116, 6:3)
  fill #2c3338 ellipse(98:116, 6:3)

  tail = lobe(42:70, 16:58, 8)
  model tail feather
  body = ellipse(68:74, 28:16)
  model body feather
  wing = ellipse(74:78, 16:8)
  model wing wingMat
  ribbon #f7fbff 88:66 112:50 132:42 7 fill
  head = ellipse(136:40, 11:9)
  model head feather
  fill #243042 ellipse(142:38, 2:2)
  poly #f0b429 144:36 184:42 144:46 fill
  pouch = curvePoly(140:46, 162:70, 148:66, 134:50)
  model pouch pouchMat
  line #f28c28 62:88 72:114 w3
  line #f28c28 76:88 94:114 w3
  fill #f28c28 ellipse(70:116, 8:3)
  fill #f28c28 ellipse(96:116, 8:3)

export ride ride:
  png @1 @4
