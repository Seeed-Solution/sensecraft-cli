{
  "name": "@seeed-studio/sensecraft-cli",
  "version": "0.5.2",
  "description": "SenseCAP / SenseCraft AI cloud CLI (devices, apps, models, files, cloud deploy)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Seeed-Solution/sensecraft-cli.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "sensecraft-cli": "bin/sensecraft-cli.js"
  },
  "scripts": {
